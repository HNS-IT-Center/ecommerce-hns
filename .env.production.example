# ============================================================================
# HNS IT Center — Environment PRODUKSI (hnsitcenter.id)
# ============================================================================
# BERKAS INI TIDAK PERNAH DIBACA SERVER. Nilai produksi yang sesungguhnya
# dipasang di hPanel Hostinger → Node.js app → Environment variables. Berkas ini
# daftar periksanya: apa yang harus ada di sana, dan nilai mana yang berbeda
# dari lokal.
#
# Kenapa perlu: variabel baru selalu lahir di `.env.local` seseorang, tempat
# fiturnya langsung jalan. Tidak ada yang mengingatkan bahwa produksi belum
# punya nilainya, dan kegagalannya di server sering diam — bukan error, cuma
# fitur yang menyala setengah.
#
# ATURAN BERKAS INI:
#   - Baris AKTIF (tanpa #) = WAJIB ada di hPanel.
#   - Baris DIKOMENTARI     = opsional; fiturnya mati dengan rapi tanpa itu.
#   - Rahasia TIDAK PERNAH ditulis di sini — pakai <placeholder>.
#
# `npm run env:cek` memeriksa berkas ini terhadap kode. Dijalankan juga di CI,
# dan MEMBLOKIR: variabel yang dipakai kode tapi tidak terdaftar di sini
# menggagalkan pemeriksaan sebelum sempat tayang.
#
# Perbedaan dengan .env.example: berkas itu acuan LOKAL (localhost, bucket uji,
# database Docker). Berkas ini nilai yang berlaku di server.
# ============================================================================


# ----------------------------------------------------------------------------
# [WAJIB] Identitas situs
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_* DIBAKAR SAAT BUILD. Mengubahnya butuh build ulang di hPanel,
# bukan sekadar restart aplikasi.
#
# Sejak cutover 14 September 2026 domainnya hnsitcenter.id — BUKAN
# store.hnsitcenter.id, yang dulu dipakai saat masih berdampingan dengan
# WordPress. Diverifikasi 21 September 2026: canonical halaman depan produksi
# berbunyi https://hnsitcenter.id.
NEXT_PUBLIC_SITE_URL=https://hnsitcenter.id
NEXT_PUBLIC_SITE_NAME=HNS IT Center

# Host gambar untuk remotePatterns next/image.
NEXT_PUBLIC_IMAGE_DOMAIN=hnsitcenter.id


# ----------------------------------------------------------------------------
# [WAJIB] WordPress / WooCommerce
# ----------------------------------------------------------------------------
# Data produk TIDAK lagi dari sini (CLAUDE.md §2.2) — WordPress tinggal
# melayani blog dan jadi host gambar lama. Variabelnya tetap wajib karena
# `config/env.ts` memvalidasinya saat aplikasi start; nilai yang salah membuat
# seluruh aplikasi gagal start, bukan cuma blognya.
#
# Sejak cutover, hnsitcenter.id dilayani Next.js dan WordPress pindah ke
# subdomain. Diverifikasi 21 September 2026: /wp-json/wp/v2/posts membalas 200
# JSON di wp.hnsitcenter.id, dan 404 HTML di hnsitcenter.id.
WOOCOMMERCE_URL=https://wp.hnsitcenter.id
WOOCOMMERCE_CONSUMER_KEY=<ck_... dari wp-admin>
WOOCOMMERCE_CONSUMER_SECRET=<cs_... dari wp-admin>


# ----------------------------------------------------------------------------
# [WAJIB] Database produksi
# ----------------------------------------------------------------------------
# MariaDB Hostinger. Untuk pengembangan, JANGAN nilai ini yang dipakai — pakai
# database Docker lokal, lihat docs/16-database-lokal-docker.md.
#
# Build menjalankan `prisma migrate deploy` sebelum `next build`, jadi setiap
# deploy menerapkan migrasi yang tertunda ke database ini.
DATABASE_URL=<mysql://user:sandi@host:3306/nama_db>


# ----------------------------------------------------------------------------
# [WAJIB] Sesi admin & pelanggan
# ----------------------------------------------------------------------------
# Minimal 32 karakter. HARUS BERBEDA dari nilai lokal: mengganti nilai ini
# membatalkan seluruh sesi yang sedang berjalan, dan itu justru yang diinginkan
# kalau suatu saat perlu memaksa semua orang login ulang.
AUTH_SECRET=<hex 32 byte>

# Nilai yang sama dipasang sebagai "Secret" di WooCommerce → Webhooks.
REVALIDATE_SECRET=<hex 32 byte>


# ----------------------------------------------------------------------------
# [WAJIB] Kontak & media
# ----------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_CS_NUMBER=<62 tanpa tanda plus>

# Bucket produksi — BUKAN ecommerce-hns-dev yang dipakai lokal. Salah isi di
# sini berarti unggahan staff mendarat di bucket uji dan gambarnya tidak pernah
# tampil ke pelanggan.
R2_ACCOUNT_ID=<32 hex>
R2_ACCESS_KEY_ID=<32 hex>
R2_SECRET_ACCESS_KEY=<64 hex>
R2_BUCKET_NAME=ecommerce-hns
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.hnsitcenter.com


# ----------------------------------------------------------------------------
# [WAJIB] Akun master developer
# ----------------------------------------------------------------------------
# Satu alamat email dengan akses penuh, diperiksa SEBELUM role apa pun. Kosong =
# tidak ada master (aman-tertutup), tapi di produksi ia pagar terakhir kalau
# owner salah mencabut izinnya sendiri. Pakai akun yang 2FA-nya menyala.
MASTER_ADMIN_EMAIL=<email developer>


# ----------------------------------------------------------------------------
# [WAJIB] Email keluar
# ----------------------------------------------------------------------------
# Verifikasi akun & reset password pelanggan. Port 465 = TLS sejak koneksi
# dibuka; tidak ada saklar SSL terpisah (diturunkan dari nomor port).
# SMTP_PASSWORD adalah password MAILBOX dari hPanel → Emails, BUKAN password
# akun hPanel.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@hnsitcenter.id
SMTP_PASSWORD=<password mailbox>
SMTP_FROM="HNS IT Center <noreply@hnsitcenter.id>"

# Balasan pelanggan diarahkan ke kotak yang BENAR-BENAR dipantau CS.
# JANGAN domain .co.id — tidak terdaftar, balasannya memantul.
EMAIL_REPLY_TO=<alamat CS di hnsitcenter.id>


# ----------------------------------------------------------------------------
# [WAJIB] Peta lokasi toko
# ----------------------------------------------------------------------------
# Tanpa ini peta toko TIDAK mati — ia turun ke mode tanpa pin terverifikasi
# Google. Justru itu masalahnya: tidak ada error, tidak ada yang sadar. Variabel
# inilah yang dulu terlewat sampai pemeriksaan ini dibuat.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=<kunci Google Maps Embed API>


# ----------------------------------------------------------------------------
# [WAJIB] Login pelanggan — Google OAuth
# ----------------------------------------------------------------------------
# Redirect URI di Google Cloud Console harus memakai domain produksi.
# Setup: docs/09-google-oauth-setup.md
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-...>


# ----------------------------------------------------------------------------
# [WAJIB] Sinkronisasi harga Accurate
# ----------------------------------------------------------------------------
# URL CSV Google Sheet yang dipublikasikan. Tanpa ini impor harga Accurate mati.
GOOGLE_SHEET_CSV_URL=<url CSV Sheet>


# ----------------------------------------------------------------------------
# [OPSIONAL] Sakelar perilaku
# ----------------------------------------------------------------------------
# Tanpa prefiks NEXT_PUBLIC_ dan itu disengaja: dibaca di sisi server saja,
# jadi mengubahnya cukup RESTART aplikasi — tidak perlu build ulang.

# "true" membuka pendaftaran manual (email+password) di /register. Selain itu —
# termasuk kalau variabelnya tidak ada — pendaftaran manual TERTUTUP.
# REGISTER_MANUAL_ENABLED=false

# Sakelar antrean pekerjaan sinkronisasi produk.
# SYNC_ENQUEUE_ENABLED=false


# ----------------------------------------------------------------------------
# [OPSIONAL] AI perapi spesifikasi produk
# ----------------------------------------------------------------------------
# Dipakai /api/admin/format-specs. Tanpa ini tombolnya membalas error yang rapi.
# GROQ_API_KEY=<gsk_...>
# GEMINI_API_KEY=<...>


# ----------------------------------------------------------------------------
# [OPSIONAL] WordPress Application Password
# ----------------------------------------------------------------------------
# Peninggalan jalur unggah gambar lewat WordPress Media, yang sudah TIDAK
# dipakai (foto produk lewat Cloudflare R2). `config/env.ts` masih membaca
# keduanya — nama pendek didahulukan. Biarkan kosong di produksi.
# WP_USERNAME=
# WP_APP_PASSWORD=
# WORDPRESS_APP_USER=
# WORDPRESS_APP_PASSWORD=


# ----------------------------------------------------------------------------
# [OPSIONAL] Database stok WooCommerce lama
# ----------------------------------------------------------------------------
# Dideklarasikan di config/env.ts tapi nol pemakai di kode. Kandidat dihapus;
# jangan diisi di produksi tanpa alasan yang jelas.
# STOCK_UPDATEWOO_DATABASE_URL=


# ============================================================================
# TIDAK PERNAH DIPASANG DI PRODUKSI
# ============================================================================
# Variabel berikut hanya hidup di .env.local masing-masing developer, dan tidak
# boleh masuk hPanel:
#
#   PROD_DATABASE_URL        — dibaca skrip tarik data; di server ia justru
#                              menyalin database ke dirinya sendiri
#   RAW_DUMP_DATABASE_URL    — database kerja impor CSV
#   RESTORE_UJI_DATABASE_URL — database uji di Hostinger
#   SSH_HOST / SSH_PORT / SSH_USER / SSH_PASSWORD
#                            — peninggalan deploy lewat SSH yang sudah dipensiun
#                              15 September 2026; sebaiknya dicabut juga dari
#                              GitHub Secrets (docs/10)
#   DB_NAME / DB_USER / DB_PASSWORD
#                            — potongan kredensial untuk skrip lama
# ============================================================================
