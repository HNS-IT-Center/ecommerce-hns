// Skema database admin panel (data non-produk: toko/lokasi, kebijakan/FAQ).
// Data produk TETAP di WooCommerce (lihat CLAUDE.md §2.2) — tabel di sini
// khusus untuk konten yang sebelumnya hardcode di kode.
//
// Setup:
//   1. Isi DATABASE_URL di .env.local (mysql://user:password@host:port/dbname)
//   2. npx prisma migrate dev --name init
//   3. npx prisma db seed   (isi konten kebijakan/FAQ yang sudah final)

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: koneksi database untuk migrate/CLI diatur di prisma.config.ts
// (bukan lagi `url` di sini), runtime PrismaClient pakai driver adapter
// (@prisma/adapter-mariadb) — lihat src/lib/prisma/client.ts.
datasource db {
  provider = "mysql"
}

// --------------------------------------------------------------------------- admin

/**
 * Pengguna admin panel.
 *
 * Sengaja BUKAN tabel Auth.js. Panel ini dipakai segelintir PIC internal, tidak
 * ada pendaftaran mandiri, dan akun dibuat manual lewat script — jadi provider
 * OAuth beserta tabel Account/Session-nya adalah mesin yang tidak terpakai.
 *
 * `email` adalah kunci sambungan antar cara login. Kalau nanti Google atau SSO
 * ditambahkan, identitas yang mereka buktikan dicocokkan ke baris ini; tabel
 * inilah yang memutuskan siapa boleh masuk, bukan providernya. Saat itu tiba,
 * tabel Account (userId + provider + providerAccountId) menyusul — belum
 * dibuat sekarang karena dengan satu provider ia kolom kosong.
 */
model User {
  id           String  @id @default(uuid())
  email        String  @unique @db.VarChar(191)
  name         String  @db.VarChar(191)

  /// Cara masuk kedua, di samping email — WAJIB, bukan pilihan. Setiap akun
  /// admin punya dua identitas dan keduanya bisa dipakai masuk; kalau kolomnya
  /// nullable, janji itu hanya berlaku untuk akun yang kebetulan mengisinya.
  ///
  /// Disimpan huruf kecil, tidak boleh mengandung '@'. Larangan itu yang membuat
  /// pemilahan "ini email atau username" tidak pernah ambigu, dan mencegah
  /// seseorang mendaftarkan username berbentuk email milik orang lain.
  username String @unique @db.VarChar(191)
  // scrypt: "salt:hash" heksadesimal, dihitung dengan crypto bawaan Node.
  passwordHash String  @map("password_hash") @db.VarChar(255)
  image        String? @db.VarChar(1000)

  /// Penanda pencabutan sesi. Token sesi bersifat stateless — tidak ada tabel
  /// sesi yang bisa dihapus barisnya — jadi pencabutan dilakukan lewat
  /// perbandingan waktu: token yang diterbitkan SEBELUM waktu di sini dianggap
  /// mati, walau tanda tangannya masih sah dan belum kedaluwarsa. Tanpa kolom
  /// ini, mengganti password tidak memutus sesi di perangkat lain sama sekali.
  ///
  /// Selalu disimpan dibulatkan ke detik utuh, karena `iat` di dalam token juga
  /// berpresisi detik. Kalau kolom ini menyimpan milidetik, token yang baru
  /// diterbitkan pada detik yang sama bisa terbaca "lebih tua" dan langsung
  /// mati sendiri.
  ///
  /// NULL berarti password belum pernah diganti sejak kolom ini ada — tidak ada
  /// sesi yang perlu dicabut.
  passwordChangedAt DateTime? @map("password_changed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Store {
  id        String @id

  /// Alamat halaman cabang, terpisah dari `id`.
  ///
  /// Dipisah karena keduanya menjawab pertanyaan berbeda. `id` menjawab "baris
  /// mana" dan direferensikan `store_hours` — mengubahnya berarti migrasi foreign
  /// key. `slug` menjawab "URL apa", dan itu memang berubah: staff salah ketik,
  /// cabang pindah, namanya diperbarui. Menyatukan keduanya membuat kesalahan
  /// ketik jadi permanen.
  ///
  /// Unik di tingkat database. Supaya penghapusan tidak mengunci alamat yang bagus
  /// selamanya — persis yang terjadi pada `id` kemarin — `softDeleteStore`
  /// membubuhkan akhiran pada slug baris yang dihapus, sehingga slug aslinya
  /// langsung bebas dipakai lagi.
  slug String @unique @db.VarChar(191)

  name      String
  address   String @db.Text
  mapsUrl   String @map("maps_url")
  sortOrder Int    @default(0) @map("sort_order")

  /// Nomor WhatsApp cabang ini. Sempat dihapus ketika dikira seluruh percakapan
  /// masuk lewat satu pintu; ternyata tiap cabang punya nomornya sendiri, dan
  /// mengarahkan pelanggan Nagoya Hill ke nomor Gateway berarti pertanyaan soal
  /// stok dijawab oleh toko yang tidak memegang barangnya.
  ///
  /// Disimpan apa adanya seperti yang diketik staff ("0821-8559-8887"); normalisasi
  /// ke bentuk internasional terjadi saat membangun tautan wa.me, supaya angka yang
  /// mereka lihat di panel sama dengan yang mereka kenal.
  ///
  /// `@default("")` semata-mata jembatan migrasi: dua toko yang sudah ada tidak
  /// punya nilai, dan kolom NOT NULL tanpa default akan menolak `db push`.
  /// Kosongnya tidak dibiarkan lolos — `assertFilled` menuntutnya terisi setiap
  /// kali toko disimpan lewat panel.
  phone String @default("")

  /// Koordinat toko. Peta dibangun dari angka ini, bukan dari pencarian teks:
  /// mencocokkan nama dan alamat menyerahkan hasilnya pada tebakan penyedia peta,
  /// dan tebakan itu sudah terbukti meleset — kedua kartu toko sempat menunjuk
  /// Pizza Hut dan sebuah kelenteng, bukan toko kalian.
  ///
  /// Nullable supaya toko bisa dibuat lebih dulu dan koordinatnya menyusul;
  /// yang belum punya koordinat jatuh ke pencarian alamat seperti sebelumnya.
  ///
  /// `Decimal` dengan sembilan angka di belakang koma, bukan `Float`: presisi
  /// biner Float menggeser titik beberapa meter setiap kali nilainya dibaca ulang,
  /// dan untuk membedakan dua ruko bersebelahan itu sudah cukup merepotkan.
  latitude  Decimal? @db.Decimal(12, 9)
  longitude Decimal? @db.Decimal(12, 9)

  /// Pengenal tempat di Google. TIDAK dipakai menggambar peta — itu tugas
  /// koordinat — melainkan untuk tombol Petunjuk Arah, supaya aplikasi Google Maps
  /// membuka listing yang persis alih-alih sekadar menuju sepasang koordinat.
  googlePlaceId String? @map("google_place_id") @db.VarChar(191)

  // Jam buka pindah ke tabel sendiri, satu baris per hari. Sebelumnya ia satu
  // string bebas ("SETIAP HARI SENIN SAMPAI SABTU 09.00 - 21.00, MINGGU ...")
  // yang tidak bisa dibaca mesin: `openingHoursSpecification` untuk Google
  // menuntut hari dan jam sebagai nilai terpisah, dan menguraikannya kembali
  // dari teks bebas hanya memindahkan tebakan ke tempat lain.
  hours StoreHours[]

  // Penghapusan menyisakan jejak, bukan melenyapkan baris. Tombol hapus di
  // layar toko sebelumnya langsung memanggil delete() tanpa konfirmasi apa pun.
  //
  // `deletedBy` sengaja bukan relasi ke User: ia jejak audit, bukan sasaran
  // query relasional. Kalau akun pelakunya suatu saat dihapus, foreign key
  // dengan SetNull justru akan menghapus keterangan siapa yang menghapus —
  // persis informasi yang ingin disimpan.
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(191)

  @@index([deletedAt])
  @@map("stores")
}

/**
 * Jam buka satu toko, satu baris per hari.
 *
 * `dayOfWeek` mengikuti `Date.getDay()` JavaScript — 0 Minggu sampai 6 Sabtu —
 * supaya tidak ada penerjemahan diam-diam antara nilai yang disimpan dan nilai
 * yang dipakai kode saat menentukan "apakah toko buka sekarang".
 *
 * `isClosed` ada karena "tutup" bukan sekadar jam kosong: hari yang tidak
 * tercatat sama sekali berarti "belum diisi staff", dan itu berbeda dari "hari
 * ini memang libur". Membedakan keduanya mencegah halaman menampilkan toko buka
 * 24 jam hanya karena barisnya belum sempat diisi.
 *
 * Jam disimpan sebagai teks "HH:MM" 24 jam, bukan DateTime: yang dicatat adalah
 * waktu dinding yang berulang tiap minggu, bukan satu titik waktu — menyimpannya
 * sebagai DateTime memaksa tanggal palsu dan mengundang pergeseran zona waktu.
 */
model StoreHours {
  id        Int     @id @default(autoincrement())
  storeId   String  @map("store_id")
  dayOfWeek Int     @map("day_of_week") @db.TinyInt
  isClosed  Boolean @default(false) @map("is_closed")
  opensAt   String  @map("opens_at") @db.VarChar(5)
  closesAt  String  @map("closes_at") @db.VarChar(5)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Satu hari hanya boleh punya satu baris per toko. Tanpa ini, dua kali simpan
  // menghasilkan Senin ganda dan halaman menampilkan dua jam yang bertentangan.
  @@unique([storeId, dayOfWeek])
  @@map("store_hours")
}

model PolicyPage {
  slug      String   @id
  title     String
  content   String   @db.Text // HTML, dirender lewat .prose + dangerouslySetInnerHTML
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("policy_pages")
}

model FaqItem {
  id        String @id @default(uuid())
  question  String @db.Text
  answer    String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  // Lihat catatan pada Store — alasan dan bentuknya sama.
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(191)

  @@index([deletedAt])
  @@map("faq_items")
}

// --------------------------------------------------------------------------- enum

enum ProductType {
  SIMPLE
  VARIABLE
  VARIATION
  GROUPED
  EXTERNAL
}

enum ProductStatus {
  PUBLISHED // CSV "Telah Terbit" = 1   (4.775 baris)
  DRAFT     // CSV "Telah Terbit" = 0   (287 baris)
  PRIVATE   // CSV "Telah Terbit" = -1  (72 baris)
}

enum StockStatus {
  INSTOCK
  OUTOFSTOCK
  ONBACKORDER
}

enum CatalogVisibility {
  VISIBLE
  CATALOG
  SEARCH
  HIDDEN
}

enum BannerDisplayMode {
  IMAGE_ONLY // Gambar mengisi seluruh slide; tanpa overlay teks / scrim gelap
  IMAGE_TEXT // Perilaku bawaan: gambar + overlay teks
}

// --------------------------------------------------------------------------- produk

model Product {
  id    Int @id @default(autoincrement())
  wooId Int @unique @map("woo_id") // ID asli WooCommerce, untuk sinkronisasi

  type   ProductType
  status ProductStatus     @default(DRAFT)
  visibility CatalogVisibility @default(VISIBLE)

  // 27,2% terisi di sumber. NULL diperbolehkan; multiple NULL sah di MySQL/MariaDB.
  sku  String? @unique @db.VarChar(100)
  gtin String? @db.VarChar(50)

  name String  @db.VarChar(500)
  slug String  @unique @db.VarChar(191)

  shortDescription String? @map("short_description") @db.Text
  description      String? @db.MediumText

  // Harga rupiah. Decimal(14,2) menampung sampai Rp 999.999.999.999,99
  regularPrice Decimal? @map("regular_price") @db.Decimal(14, 2)
  salePrice    Decimal? @map("sale_price")    @db.Decimal(14, 2)

  // Batas akhir masa obral. NULL = obral tanpa batas waktu.
  // Kolomnya TIDAK dikosongkan otomatis saat lewat tanggal — nilai obral tetap
  // tersimpan sebagai riwayat, dan yang mengabaikannya adalah lapisan baca
  // (prismaProductToWoo + filter onSale). Dengan begitu obral berakhir tepat
  // pada detik tanggalnya tanpa bergantung pada cron yang bisa saja mati.
  saleEndDate DateTime? @map("sale_end_date")

  stockStatus  StockStatus? @map("stock_status")
  stockQty     Int?         @map("stock_qty")
  backordersAllowed Boolean? @map("backorders_allowed")
  soldIndividually  Boolean? @map("sold_individually")
  reviewsAllowed    Boolean? @map("reviews_allowed")

  // Satu video per produk — link eksternal (YouTube/Vimeo/mp4) atau URL R2 hasil upload.
  videoUrl String? @map("video_url") @db.VarChar(1000)

  featured  Boolean @default(false)
  viewCount Int     @default(0) @map("view_count")

  // Relasi induk-varian (product type VARIATION menunjuk ke VARIABLE)
  parentId   Int?      @map("parent_id")
  parent     Product?  @relation("ProductVariations", fields: [parentId], references: [id], onDelete: SetNull)
  variations Product[] @relation("ProductVariations")

  brandId Int?   @map("brand_id")
  brand   Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  categories ProductCategory[]
  tags       ProductTag[]
  images     ProductImage[]
  attributes ProductAttribute[]

  // Jejak migrasi — dibuang setelah Woo pensiun & data terverifikasi
  importNotes String?  @map("import_notes") @db.Text
  importedAt  DateTime @default(now()) @map("imported_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([parentId])
  @@index([brandId])
  @@index([regularPrice])
  @@index([status, type])
  @@fulltext([name])
  @@map("products")
}

// --------------------------------------------------------------------------- banner promo

/**
 * Slide hero di beranda.
 *
 * Sebelumnya berupa array yang ditulis langsung di dalam
 * features/home/components/hero-carousel.tsx, sehingga mengganti promo mingguan
 * berarti menyunting kode dan menunggu deploy.
 *
 * `startsAt`/`endsAt` TIDAK ditegakkan lewat cron. Sama seperti masa berlaku
 * harga obral, jadwalnya dihitung saat dibaca (lihat lib/api/banners.ts) supaya
 * promo mulai dan berhenti tepat waktu tanpa bergantung pada job yang bisa mati.
 */
model PromoBanner {
  id String @id @default(uuid())

  tag      String? @db.VarChar(100)
  title    String  @db.VarChar(255)
  subtitle String? @db.VarChar(500)

  ctaLabel String? @map("cta_label") @db.VarChar(100)
  ctaHref  String? @map("cta_href")  @db.VarChar(1000)

  /// Gambar latar opsional. Kalau kosong, slide memakai warna solid `bgClass`.
  imageUrl String? @map("image_url") @db.VarChar(1000)
  bgClass  String  @default("bg-primary") @map("bg_class") @db.VarChar(100)

  displayMode BannerDisplayMode @default(IMAGE_TEXT) @map("display_mode")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("promo_banners")
}

// --------------------------------------------------------------------------- kategori

model Category {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  // Slug memakai path penuh, bukan nama saja.
  // Alasan konkret: "COLORFUL" muncul di bawah LAPTOP OFFICE dan LAPTOP GAMING.
  // Slug berbasis nama saja akan bertabrakan.
  slug String @unique @db.VarChar(191)

  // Path lengkap: "KOMPONEN PC / NB > MOTHERBOARD > MOTHERBOARD INTEL"
  path  String @unique @db.VarChar(500)
  depth Int    @default(1)

  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  @@index([parentId])
  @@index([depth])
  @@map("categories")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  // Kategori utama produk: satu jalur yang dianggap "rumah" sebenarnya.
  // Dipakai untuk breadcrumb, URL kanonik, dan laporan per kategori — tiga hal
  // yang tidak punya jawaban selama produk bisa berada di beberapa cabang tanpa
  // ada yang ditandai utama.
  //
  // Tidak ada constraint database yang membatasi satu primary per produk:
  // MariaDB tidak punya partial unique index, jadi aturan itu ditegakkan di
  // lapisan aplikasi (`setPrimaryCategory` membersihkan tanda lama dalam satu
  // transaksi sebelum menandai yang baru).
  isPrimary Boolean @default(false) @map("is_primary")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// --------------------------------------------------------------------------- brand

model Brand {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(191)
  slug String @unique @db.VarChar(191)

  products Product[]

  @@map("brands")
}

// --------------------------------------------------------------------------- tag

model Tag {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(191)
  slug String @unique @db.VarChar(191)

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId Int @map("product_id")
  tagId     Int @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// --------------------------------------------------------------------------- gambar

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  url       String  @db.VarChar(1000)
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// --------------------------------------------------------------------------- atribut

// Sumber punya 5 pasang kolom "Nama Atribut N" / "Nilai Atribut N".
// Dinormalisasi jadi master Attribute + AttributeValue, supaya form upload
// produk di website baru bisa nampilin pilihan attribute lalu pilihan value
// yang sudah ada (bukan isian teks bebas). Nama attribute sudah dirapikan
// dari 73 varian mentah (beda kapitalisasi/tanda titik dua) jadi 60 unik —
// tapi masih ada beberapa yang perlu digabung manual (lihat catatan migrasi).
model Attribute {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(191)

  values             AttributeValue[]
  productAttributes  ProductAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id          Int    @id @default(autoincrement())
  attributeId Int    @map("attribute_id")
  value       String @db.VarChar(191)

  attribute         Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributes ProductAttribute[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttribute {
  id          Int @id @default(autoincrement())
  productId   Int @map("product_id")
  attributeId Int @map("attribute_id")
  valueId     Int @map("value_id")
  position    Int @default(0)

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId, valueId])
  @@index([productId])
  @@index([attributeId])
  @@index([valueId])
  @@map("product_attributes")
}

// --------------------------------------------------------------------------- karantina

// Baris yang tidak lolos validasi TIDAK dibuang diam-diam.
// Disimpan mentah supaya bisa diperiksa manual dan diperbaiki di sumber.
model ImportQuarantine {
  id        Int      @id @default(autoincrement())
  rowNumber Int      @map("row_number")
  wooId     String?  @map("woo_id") @db.VarChar(50)
  issues    String   @db.VarChar(500)
  rawData   String   @map("raw_data") @db.MediumText
  createdAt DateTime @default(now()) @map("created_at")

  @@map("import_quarantine")
}

// --------------------------------------------------------------------------- setting

// Digunakan untuk menyimpan konfigurasi global situs (misal: PC Builder steps)
model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// --------------------------------------------------------------------------- logs

model ProductLog {
  id            Int      @id @default(autoincrement())
  userName      String   @db.VarChar(191) // "System" atau nama Admin
  productId     Int      @map("product_id")
  productName   String   @map("product_name") @db.VarChar(500)
  action        String   @db.VarChar(100) // e.g., "UPDATE_PRICE", "QUICK_EDIT", "DELETE"
  fieldAffected String   @map("field_affected") @db.VarChar(100) // e.g., "regular_price", "multiple"
  oldValue      String?  @map("old_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("product_logs")
}

/**
 * Quotation rakitan PC yang pernah dicetak dari /build-pc.
 *
 * Satu baris = satu KOMBINASI komponen unik, bukan satu klik Print. Dua orang
 * yang merakit isi yang sama persis akan berbagi baris ini; yang bertambah
 * hanya `printCount`. Tanpa itu, tabel akan penuh duplikat karena satu orang
 * biasa menekan Print berkali-kali untuk rakitan yang sama.
 *
 * `items` menyimpan snapshot harga saat quotation diterbitkan, supaya halaman
 * verifikasi /q/[code] bisa membandingkannya dengan harga terkini dan
 * menandai kalau ada selisih.
 */
model PcBuildQuote {
  id   Int    @id @default(autoincrement())
  // Kode yang dicetak di PDF, mis. "HNSPC-260804-7K3M".
  code String @unique @db.VarChar(32)
  // SHA-256 dari daftar `productId:qty` terurut. Inilah kunci dedupe-nya.
  contentHash String @unique @map("content_hash") @db.VarChar(64)

  // Snapshot: [{ productId, name, sku, price, quantity, stepName }]
  items Json

  subtotal    Decimal @db.Decimal(14, 2)
  assemblyFee Decimal @map("assembly_fee") @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  itemCount  Int @map("item_count")
  printCount Int @default(1) @map("print_count")

  createdAt     DateTime @default(now()) @map("created_at")
  lastPrintedAt DateTime @default(now()) @map("last_printed_at")

  @@index([createdAt])
  @@index([lastPrintedAt])
  @@map("pc_build_quotes")
}
