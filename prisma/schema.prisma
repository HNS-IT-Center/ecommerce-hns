// Skema database admin panel (data non-produk: toko/lokasi, kebijakan/FAQ).
// Data produk TETAP di WooCommerce (lihat CLAUDE.md §2.2) — tabel di sini
// khusus untuk konten yang sebelumnya hardcode di kode.
//
// Setup:
//   1. Isi DATABASE_URL di .env.local (mysql://user:password@host:port/dbname)
//   2. npx prisma migrate dev --name init
//   3. npx prisma db seed   (isi konten kebijakan/FAQ yang sudah final)

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: koneksi database untuk migrate/CLI diatur di prisma.config.ts
// (bukan lagi `url` di sini), runtime PrismaClient pakai driver adapter
// (@prisma/adapter-mariadb) — lihat src/lib/prisma/client.ts.
datasource db {
  provider = "mysql"
}

// --------------------------------------------------------------------------- admin

/**
 * Pengguna admin panel.
 *
 * Sengaja BUKAN tabel Auth.js. Panel ini dipakai segelintir PIC internal, tidak
 * ada pendaftaran mandiri, dan akun dibuat manual lewat script — jadi provider
 * OAuth beserta tabel Account/Session-nya adalah mesin yang tidak terpakai.
 *
 * `email` adalah kunci sambungan antar cara login. Kalau nanti Google atau SSO
 * ditambahkan, identitas yang mereka buktikan dicocokkan ke baris ini; tabel
 * inilah yang memutuskan siapa boleh masuk, bukan providernya. Saat itu tiba,
 * tabel Account (userId + provider + providerAccountId) menyusul — belum
 * dibuat sekarang karena dengan satu provider ia kolom kosong.
 */
model User {
  id           String  @id @default(uuid())
  email        String  @unique @db.VarChar(191)
  name         String  @db.VarChar(191)

  /// Cara masuk kedua, di samping email — WAJIB, bukan pilihan. Setiap akun
  /// admin punya dua identitas dan keduanya bisa dipakai masuk; kalau kolomnya
  /// nullable, janji itu hanya berlaku untuk akun yang kebetulan mengisinya.
  ///
  /// Disimpan huruf kecil, tidak boleh mengandung '@'. Larangan itu yang membuat
  /// pemilahan "ini email atau username" tidak pernah ambigu, dan mencegah
  /// seseorang mendaftarkan username berbentuk email milik orang lain.
  username String @unique @db.VarChar(191)
  // scrypt: "salt:hash" heksadesimal, dihitung dengan crypto bawaan Node.
  passwordHash String  @map("password_hash") @db.VarChar(255)
  image        String? @db.VarChar(1000)

  /// Penanda pencabutan sesi. Token sesi bersifat stateless — tidak ada tabel
  /// sesi yang bisa dihapus barisnya — jadi pencabutan dilakukan lewat
  /// perbandingan waktu: token yang diterbitkan SEBELUM waktu di sini dianggap
  /// mati, walau tanda tangannya masih sah dan belum kedaluwarsa. Tanpa kolom
  /// ini, mengganti password tidak memutus sesi di perangkat lain sama sekali.
  ///
  /// Selalu disimpan dibulatkan ke detik utuh, karena `iat` di dalam token juga
  /// berpresisi detik. Kalau kolom ini menyimpan milidetik, token yang baru
  /// diterbitkan pada detik yang sama bisa terbaca "lebih tua" dan langsung
  /// mati sendiri.
  ///
  /// NULL berarti password belum pernah diganti sejak kolom ini ada — tidak ada
  /// sesi yang perlu dicabut.
  passwordChangedAt DateTime? @map("password_changed_at")

  /// "owner" | "staff" — lihat `AdminRole` di lib/auth/roles.ts.
  ///
  /// String biasa, bukan enum Prisma: docs/06-coding-standards.md §1.4, pola
  /// yang sama dipakai `customer_verification_tokens.purpose`.
  ///
  /// Bedanya cuma satu hal hari ini — `owner` boleh menghapus akun pelanggan
  /// secara permanen, `staff` tidak. Penghapusan itu tidak bisa dibatalkan
  /// (CLAUDE.md §2.8: hard delete, cascade ke rakitan tersimpan), jadi ia tidak
  /// pantas tersedia untuk setiap orang yang kebetulan bisa masuk panel.
  ///
  /// `@default("owner")`, BUKAN "staff". Kolom ini lahir di database yang sudah
  /// berisi admin aktif; kalau baris lama jatuh ke `staff`, tidak ada satu pun
  /// owner tersisa dan panel mengunci dirinya sendiri — termasuk mengunci
  /// kemampuan menaikkan orang kembali. Default longgar di sini adalah pilihan
  /// sadar: menurunkan orang lewat panel itu mudah, memulihkan panel yang
  /// terkunci butuh akses SQL langsung.
  ///
  /// Penjaga terkait ada di `assertNotLastOwner` (lib/api/admin-users.ts):
  /// owner terakhir tidak boleh menurunkan dirinya sendiri, dengan alasan yang
  /// sama persis.
  role String @default("owner") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Store {
  id        String @id

  /// Alamat halaman cabang, terpisah dari `id`.
  ///
  /// Dipisah karena keduanya menjawab pertanyaan berbeda. `id` menjawab "baris
  /// mana" dan direferensikan `store_hours` — mengubahnya berarti migrasi foreign
  /// key. `slug` menjawab "URL apa", dan itu memang berubah: staff salah ketik,
  /// cabang pindah, namanya diperbarui. Menyatukan keduanya membuat kesalahan
  /// ketik jadi permanen.
  ///
  /// Unik di tingkat database. Supaya penghapusan tidak mengunci alamat yang bagus
  /// selamanya — persis yang terjadi pada `id` kemarin — `softDeleteStore`
  /// membubuhkan akhiran pada slug baris yang dihapus, sehingga slug aslinya
  /// langsung bebas dipakai lagi.
  slug String @unique @db.VarChar(191)

  name      String
  address   String @db.Text
  mapsUrl   String @map("maps_url")
  sortOrder Int    @default(0) @map("sort_order")

  /// Nomor WhatsApp cabang ini. Sempat dihapus ketika dikira seluruh percakapan
  /// masuk lewat satu pintu; ternyata tiap cabang punya nomornya sendiri, dan
  /// mengarahkan pelanggan Nagoya Hill ke nomor Gateway berarti pertanyaan soal
  /// stok dijawab oleh toko yang tidak memegang barangnya.
  ///
  /// Disimpan apa adanya seperti yang diketik staff ("0821-8559-8887"); normalisasi
  /// ke bentuk internasional terjadi saat membangun tautan wa.me, supaya angka yang
  /// mereka lihat di panel sama dengan yang mereka kenal.
  ///
  /// `@default("")` semata-mata jembatan migrasi: dua toko yang sudah ada tidak
  /// punya nilai, dan kolom NOT NULL tanpa default akan menolak `db push`.
  /// Kosongnya tidak dibiarkan lolos — `assertFilled` menuntutnya terisi setiap
  /// kali toko disimpan lewat panel.
  phone String @default("")

  /// Koordinat toko. Peta dibangun dari angka ini, bukan dari pencarian teks:
  /// mencocokkan nama dan alamat menyerahkan hasilnya pada tebakan penyedia peta,
  /// dan tebakan itu sudah terbukti meleset — kedua kartu toko sempat menunjuk
  /// Pizza Hut dan sebuah kelenteng, bukan toko kalian.
  ///
  /// Nullable supaya toko bisa dibuat lebih dulu dan koordinatnya menyusul;
  /// yang belum punya koordinat jatuh ke pencarian alamat seperti sebelumnya.
  ///
  /// `Decimal` dengan sembilan angka di belakang koma, bukan `Float`: presisi
  /// biner Float menggeser titik beberapa meter setiap kali nilainya dibaca ulang,
  /// dan untuk membedakan dua ruko bersebelahan itu sudah cukup merepotkan.
  latitude  Decimal? @db.Decimal(12, 9)
  longitude Decimal? @db.Decimal(12, 9)

  /// Pengenal tempat di Google. TIDAK dipakai menggambar peta — itu tugas
  /// koordinat — melainkan untuk tombol Petunjuk Arah, supaya aplikasi Google Maps
  /// membuka listing yang persis alih-alih sekadar menuju sepasang koordinat.
  googlePlaceId String? @map("google_place_id") @db.VarChar(191)

  // Jam buka pindah ke tabel sendiri, satu baris per hari. Sebelumnya ia satu
  // string bebas ("SETIAP HARI SENIN SAMPAI SABTU 09.00 - 21.00, MINGGU ...")
  // yang tidak bisa dibaca mesin: `openingHoursSpecification` untuk Google
  // menuntut hari dan jam sebagai nilai terpisah, dan menguraikannya kembali
  // dari teks bebas hanya memindahkan tebakan ke tempat lain.
  hours StoreHours[]

  // Penghapusan menyisakan jejak, bukan melenyapkan baris. Tombol hapus di
  // layar toko sebelumnya langsung memanggil delete() tanpa konfirmasi apa pun.
  //
  // `deletedBy` sengaja bukan relasi ke User: ia jejak audit, bukan sasaran
  // query relasional. Kalau akun pelakunya suatu saat dihapus, foreign key
  // dengan SetNull justru akan menghapus keterangan siapa yang menghapus —
  // persis informasi yang ingin disimpan.
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(191)

  @@index([deletedAt])
  @@map("stores")
}

/**
 * Jam buka satu toko, satu baris per hari.
 *
 * `dayOfWeek` mengikuti `Date.getDay()` JavaScript — 0 Minggu sampai 6 Sabtu —
 * supaya tidak ada penerjemahan diam-diam antara nilai yang disimpan dan nilai
 * yang dipakai kode saat menentukan "apakah toko buka sekarang".
 *
 * `isClosed` ada karena "tutup" bukan sekadar jam kosong: hari yang tidak
 * tercatat sama sekali berarti "belum diisi staff", dan itu berbeda dari "hari
 * ini memang libur". Membedakan keduanya mencegah halaman menampilkan toko buka
 * 24 jam hanya karena barisnya belum sempat diisi.
 *
 * Jam disimpan sebagai teks "HH:MM" 24 jam, bukan DateTime: yang dicatat adalah
 * waktu dinding yang berulang tiap minggu, bukan satu titik waktu — menyimpannya
 * sebagai DateTime memaksa tanggal palsu dan mengundang pergeseran zona waktu.
 */
model StoreHours {
  id        Int     @id @default(autoincrement())
  storeId   String  @map("store_id")
  dayOfWeek Int     @map("day_of_week") @db.TinyInt
  isClosed  Boolean @default(false) @map("is_closed")
  opensAt   String  @map("opens_at") @db.VarChar(5)
  closesAt  String  @map("closes_at") @db.VarChar(5)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Satu hari hanya boleh punya satu baris per toko. Tanpa ini, dua kali simpan
  // menghasilkan Senin ganda dan halaman menampilkan dua jam yang bertentangan.
  @@unique([storeId, dayOfWeek])
  @@map("store_hours")
}

model PolicyPage {
  slug      String   @id
  title     String
  content   String   @db.Text // HTML, dirender lewat .prose + dangerouslySetInnerHTML
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("policy_pages")
}

model FaqItem {
  id        String @id @default(uuid())
  question  String @db.Text
  answer    String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  // Lihat catatan pada Store — alasan dan bentuknya sama.
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(191)

  @@index([deletedAt])
  @@map("faq_items")
}

// --------------------------------------------------------------------------- enum

enum ProductType {
  SIMPLE
  VARIABLE
  VARIATION
  GROUPED
  EXTERNAL
}

enum ProductStatus {
  PUBLISHED // CSV "Telah Terbit" = 1   (4.775 baris)
  DRAFT     // CSV "Telah Terbit" = 0   (287 baris)
  PRIVATE   // CSV "Telah Terbit" = -1  (72 baris)
}

enum StockStatus {
  INSTOCK
  OUTOFSTOCK
  ONBACKORDER
}

enum CatalogVisibility {
  VISIBLE
  CATALOG
  SEARCH
  HIDDEN
}

enum BannerDisplayMode {
  IMAGE_ONLY // Gambar mengisi seluruh slide; tanpa overlay teks / scrim gelap
  IMAGE_TEXT // Perilaku bawaan: gambar + overlay teks
}

// --------------------------------------------------------------------------- produk

model Product {
  id    Int @id @default(autoincrement())
  wooId Int @unique @map("woo_id") // ID asli WooCommerce, untuk sinkronisasi

  type   ProductType
  status ProductStatus     @default(DRAFT)
  visibility CatalogVisibility @default(VISIBLE)

  // 27,2% terisi di sumber. NULL diperbolehkan; multiple NULL sah di MySQL/MariaDB.
  sku  String? @unique @db.VarChar(100)
  gtin String? @db.VarChar(50)

  name String  @db.VarChar(500)
  slug String  @unique @db.VarChar(191)

  shortDescription String? @map("short_description") @db.Text
  description      String? @db.MediumText

  // Harga rupiah. Decimal(14,2) menampung sampai Rp 999.999.999.999,99
  regularPrice Decimal? @map("regular_price") @db.Decimal(14, 2)
  salePrice    Decimal? @map("sale_price")    @db.Decimal(14, 2)

  // Batas akhir masa obral. NULL = obral tanpa batas waktu.
  // Kolomnya TIDAK dikosongkan otomatis saat lewat tanggal — nilai obral tetap
  // tersimpan sebagai riwayat, dan yang mengabaikannya adalah lapisan baca
  // (prismaProductToWoo + filter onSale). Dengan begitu obral berakhir tepat
  // pada detik tanggalnya tanpa bergantung pada cron yang bisa saja mati.
  saleEndDate DateTime? @map("sale_end_date")

  stockStatus  StockStatus? @map("stock_status")
  stockQty     Int?         @map("stock_qty")
  backordersAllowed Boolean? @map("backorders_allowed")
  soldIndividually  Boolean? @map("sold_individually")
  reviewsAllowed    Boolean? @map("reviews_allowed")

  // Satu video per produk — link eksternal (YouTube/Vimeo/mp4) atau URL R2 hasil upload.
  videoUrl String? @map("video_url") @db.VarChar(1000)

  featured  Boolean @default(false)
  viewCount Int     @default(0) @map("view_count")

  // Relasi induk-varian (product type VARIATION menunjuk ke VARIABLE)
  parentId   Int?      @map("parent_id")
  parent     Product?  @relation("ProductVariations", fields: [parentId], references: [id], onDelete: SetNull)
  variations Product[] @relation("ProductVariations")

  brandId Int?   @map("brand_id")
  brand   Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  categories ProductCategory[]
  tags       ProductTag[]
  images     ProductImage[]
  attributes ProductAttribute[]

  // Jejak migrasi — dibuang setelah Woo pensiun & data terverifikasi
  importNotes String?  @map("import_notes") @db.Text
  importedAt  DateTime @default(now()) @map("imported_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([parentId])
  @@index([brandId])
  @@index([regularPrice])
  @@index([status, type])
  @@fulltext([name])
  @@map("products")
}

// --------------------------------------------------------------------------- banner promo

/**
 * Slide hero di beranda.
 *
 * Sebelumnya berupa array yang ditulis langsung di dalam
 * features/home/components/hero-carousel.tsx, sehingga mengganti promo mingguan
 * berarti menyunting kode dan menunggu deploy.
 *
 * `startsAt`/`endsAt` TIDAK ditegakkan lewat cron. Sama seperti masa berlaku
 * harga obral, jadwalnya dihitung saat dibaca (lihat lib/api/banners.ts) supaya
 * promo mulai dan berhenti tepat waktu tanpa bergantung pada job yang bisa mati.
 */
model PromoBanner {
  id String @id @default(uuid())

  tag      String? @db.VarChar(100)
  title    String  @db.VarChar(255)
  subtitle String? @db.VarChar(500)

  ctaLabel String? @map("cta_label") @db.VarChar(100)
  ctaHref  String? @map("cta_href")  @db.VarChar(1000)

  /// Gambar latar opsional. Kalau kosong, slide memakai warna solid `bgClass`.
  imageUrl String? @map("image_url") @db.VarChar(1000)
  bgClass  String  @default("bg-primary") @map("bg_class") @db.VarChar(100)

  displayMode BannerDisplayMode @default(IMAGE_TEXT) @map("display_mode")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("promo_banners")
}

// --------------------------------------------------------------------------- kategori

model Category {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  // Slug memakai path penuh, bukan nama saja.
  // Alasan konkret: "COLORFUL" muncul di bawah LAPTOP OFFICE dan LAPTOP GAMING.
  // Slug berbasis nama saja akan bertabrakan.
  slug String @unique @db.VarChar(191)

  // Path lengkap: "KOMPONEN PC / NB > MOTHERBOARD > MOTHERBOARD INTEL"
  path  String @unique @db.VarChar(500)
  depth Int    @default(1)

  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  @@index([parentId])
  @@index([depth])
  @@map("categories")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  // Kategori utama produk: satu jalur yang dianggap "rumah" sebenarnya.
  // Dipakai untuk breadcrumb, URL kanonik, dan laporan per kategori — tiga hal
  // yang tidak punya jawaban selama produk bisa berada di beberapa cabang tanpa
  // ada yang ditandai utama.
  //
  // Tidak ada constraint database yang membatasi satu primary per produk:
  // MariaDB tidak punya partial unique index, jadi aturan itu ditegakkan di
  // lapisan aplikasi (`setPrimaryCategory` membersihkan tanda lama dalam satu
  // transaksi sebelum menandai yang baru).
  isPrimary Boolean @default(false) @map("is_primary")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// --------------------------------------------------------------------------- brand

model Brand {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(191)
  slug String @unique @db.VarChar(191)

  /// URL logo di R2 (lihat `lib/api/cloudflare/r2.ts`), diunggah lewat
  /// /api/admin/media seperti gambar produk.
  ///
  /// NULLABLE dan sengaja begitu: brand yang sudah ada tidak punya logo, dan
  /// memaksa kolom ini wajib berarti setiap baris lama harus diisi lebih dulu.
  /// VarChar(500) mengikuti panjang URL R2 yang sudah dipakai kolom gambar lain.
  logoUrl String? @map("logo_url") @db.VarChar(500)

  products Product[]

  @@map("brands")
}

// --------------------------------------------------------------------------- tag

model Tag {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(191)
  slug String @unique @db.VarChar(191)

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId Int @map("product_id")
  tagId     Int @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// --------------------------------------------------------------------------- gambar

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  url       String  @db.VarChar(1000)
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// --------------------------------------------------------------------------- atribut

// Sumber punya 5 pasang kolom "Nama Atribut N" / "Nilai Atribut N".
// Dinormalisasi jadi master Attribute + AttributeValue, supaya form upload
// produk di website baru bisa nampilin pilihan attribute lalu pilihan value
// yang sudah ada (bukan isian teks bebas). Nama attribute sudah dirapikan
// dari 73 varian mentah (beda kapitalisasi/tanda titik dua) jadi 60 unik —
// tapi masih ada beberapa yang perlu digabung manual (lihat catatan migrasi).
model Attribute {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(191)

  values             AttributeValue[]
  productAttributes  ProductAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id          Int    @id @default(autoincrement())
  attributeId Int    @map("attribute_id")
  value       String @db.VarChar(191)

  attribute         Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributes ProductAttribute[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttribute {
  id          Int @id @default(autoincrement())
  productId   Int @map("product_id")
  attributeId Int @map("attribute_id")
  valueId     Int @map("value_id")
  position    Int @default(0)

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId, valueId])
  @@index([productId])
  @@index([attributeId])
  @@index([valueId])
  @@map("product_attributes")
}

// --------------------------------------------------------------------------- karantina

// Baris yang tidak lolos validasi TIDAK dibuang diam-diam.
// Disimpan mentah supaya bisa diperiksa manual dan diperbaiki di sumber.
model ImportQuarantine {
  id        Int      @id @default(autoincrement())
  rowNumber Int      @map("row_number")
  wooId     String?  @map("woo_id") @db.VarChar(50)
  issues    String   @db.VarChar(500)
  rawData   String   @map("raw_data") @db.MediumText
  createdAt DateTime @default(now()) @map("created_at")

  @@map("import_quarantine")
}

// --------------------------------------------------------------------------- setting

// Digunakan untuk menyimpan konfigurasi global situs (misal: PC Builder steps)
model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// --------------------------------------------------------------------------- logs

model ProductLog {
  id            Int      @id @default(autoincrement())
  userName      String   @db.VarChar(191) // "System" atau nama Admin
  productId     Int      @map("product_id")
  productName   String   @map("product_name") @db.VarChar(500)
  action        String   @db.VarChar(100) // e.g., "UPDATE_PRICE", "QUICK_EDIT", "DELETE"
  fieldAffected String   @map("field_affected") @db.VarChar(100) // e.g., "regular_price", "multiple"
  oldValue      String?  @map("old_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("product_logs")
}

/**
 * Quotation rakitan PC yang pernah dicetak dari /build-pc.
 *
 * Satu baris = satu KOMBINASI komponen unik, bukan satu klik Print. Dua orang
 * yang merakit isi yang sama persis akan berbagi baris ini. Tanpa dedupe itu,
 * tabel akan penuh duplikat karena satu orang biasa menekan Print berkali-kali
 * untuk rakitan yang sama.
 *
 * `items` menyimpan snapshot harga saat quotation diterbitkan, supaya halaman
 * verifikasi /q/[code] bisa membandingkannya dengan harga terkini dan
 * menandai kalau ada selisih. `updatedAt` menandai kapan snapshot itu terakhir
 * disegarkan.
 */
model PcBuildQuote {
  id   Int    @id @default(autoincrement())
  // Kode yang dicetak di PDF, mis. "HNSPC-260804-7K3M".
  code String @unique @db.VarChar(32)
  // SHA-256 dari daftar `productId:qty` terurut. Inilah kunci dedupe-nya.
  contentHash String @unique @map("content_hash") @db.VarChar(64)

  // Snapshot: [{ productId, name, sku, price, quantity, stepName }]
  items Json

  subtotal    Decimal @db.Decimal(14, 2)
  assemblyFee Decimal @map("assembly_fee") @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  itemCount Int @map("item_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// Sisi balik relasi ke `PcBuildSubmission`. WAJIB ada karena Prisma menolak
  /// relasi satu arah — tapi ia TIDAK menghasilkan kolom apa pun di database.
  ///
  /// JANGAN PERNAH meng-`include` field ini pada jalur yang bisa diakses publik.
  /// `pc_build_submissions` berisi nama dan nomor WhatsApp pelanggan, sedangkan
  /// `/verify/[code]` adalah halaman terbuka tanpa autentikasi. Yang menjaga
  /// keduanya terpisah adalah `getQuoteByCode()` yang tidak menyertakan relasi
  /// ini — bukan ketiadaan field-nya.
  submissions PcBuildSubmission[]

  @@index([createdAt])
  @@index([updatedAt])
  @@map("pc_build_quotes")
}

/**
 * Rakitan yang DIKIRIM pelanggan ke HNS lewat tombol "Kirim ke HNS".
 *
 * Tabel sendiri, bukan kolom tambahan di `PcBuildQuote`, dan alasannya struktural.
 * `contentHash` di sana `@unique`, sehingga dua baris dengan isi rakitan sama
 * mustahil ada. Kalau identitas pengirim ditaruh di tabel itu, kiriman pelanggan
 * yang isinya kebetulan sama dengan quotation milik staff akan masuk cabang
 * `update` dan MENIMPA datanya — dan pelanggan kedua yang mengirim rakitan sama
 * menimpa yang pertama. Rakitan dari preset yang sama menghasilkan hash identik,
 * jadi kebetulan itu tidak jarang.
 *
 * Perbedaan yang mendasarinya: untuk quotation cetak, isi rakitan ADALAH identitas
 * dokumen — dua cetakan dengan isi sama memang satu dokumen. Untuk kiriman
 * pelanggan, yang menjadi identitas adalah PENGIRIMNYA. Dua orang mengirim rakitan
 * RTX 4060 yang sama adalah dua prospek, bukan satu.
 *
 * Karena itu tidak ada constraint unik apa pun di sini: satu baris per kiriman,
 * selalu.
 */
model PcBuildSubmission {
  id Int @id @default(autoincrement())

  /// Relasi lewat `id`, BUKAN lewat `code`. Kode adalah pengenal yang dibaca
  /// manusia dan formatnya bisa berubah suatu hari; kalau relasinya bersandar
  /// pada kode, perubahan format memutus sambungannya.
  quoteId Int          @map("quote_id")
  quote   PcBuildQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Salinan kode saat kiriman dibuat, supaya daftar di panel bisa menampilkannya
  /// tanpa join. Sengaja BUKAN sumber kebenaran — `quote.code` yang berlaku.
  quoteCode String @map("quote_code") @db.VarChar(32)

  /// Data pribadi. Lihat catatan retensi di bawah.
  customerName  String @map("customer_name") @db.VarChar(120)
  customerPhone String @map("customer_phone") @db.VarChar(32)

  /// "baru" | "dibaca" | "selesai". Penggerak lencana di panel admin: yang
  /// dihitung hanya yang berstatus "baru", dan staff bisa memadamkannya dengan
  /// menandai sudah dibaca. Lencana yang tidak pernah bisa padam berubah jadi
  /// hiasan yang diabaikan.
  status String @default("baru") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at")

  /// RETENSI 12 BULAN. Nama dan nomor WhatsApp adalah data pribadi dan tidak
  /// boleh disimpan selamanya. Penghapusannya dijalankan terpisah (skrip
  /// berkala), bukan otomatis oleh database — supaya terlihat dan bisa
  /// dihentikan kalau suatu saat aturannya berubah.
  ///
  /// Tabel ini TIDAK BOLEH terjangkau dari endpoint publik mana pun. Halaman
  /// verifikasi /verify/[code] membaca `pc_build_quotes` saja, dan relasinya
  /// sengaja satu arah — `PcBuildQuote` tidak punya balikan ke sini, sehingga
  /// identitas pelanggan tidak punya jalan sampai ke halaman publik itu.
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("pc_build_submissions")
}

// --------------------------------------------------------------------------- akun pelanggan

/**
 * Akun pelanggan — login Google. Tabel TERPISAH dari `User` (akun admin);
 * lihat docs/09-google-oauth-setup.md §1 kenapa keduanya tidak boleh
 * disatukan (googleId di `users` berarti siapa pun yang membuat akun Google
 * atas email seorang staf bisa masuk ke panel admin).
 *
 * Rancangan final ada di docs/09 §8 — dicatat ulang di sini karena kolomnya
 * sengaja minim, dan alasan "kenapa tidak lebih" sama pentingnya dengan
 * "kenapa ada":
 * - Kunci identitas adalah `googleSub`, BUKAN email. Email bisa diganti
 *   pemiliknya di akun Google; kalau itu jadi kunci, akun yang sudah punya
 *   rakitan tersimpan bisa "hilang" begitu emailnya berubah.
 * - Tidak ada access/refresh token yang disimpan — dipakai sekali saat
 *   login lalu dibuang.
 * - Tidak ada foto profil — halaman akun tidak memakainya, dan data pribadi
 *   paling aman adalah yang tidak pernah disimpan.
 *
 * Penghapusan akun ini HARD DELETE (lihat CLAUDE.md §2.8), bukan soft
 * delete seperti `users`/`stores`. Ini data pribadi milik pelanggan sendiri;
 * kalau mereka minta dihapus, menyembunyikan barisnya lewat `deletedAt`
 * berarti kita tetap menyimpan email dan nama yang sudah diminta dihapus —
 * kebalikan dari yang diminta.
 */
model Customer {
  id String @id @default(uuid())

  /// Subject claim dari id_token Google (`sub`). Unik dan tidak pernah
  /// berubah untuk satu akun Google, tidak seperti email.
  ///
  /// NULLABLE sejak login email+password ditambahkan (2026-08-12) — akun
  /// yang daftar manual tidak pernah punya ini. Satu akun cuma pernah punya
  /// SATU jalur identitas (Google ATAU email+password), tidak pernah
  /// digabung: kalau email yang sama sudah terdaftar lewat Google, daftar
  /// manual dengan email itu ditolak dan diarahkan pakai Google — bukan
  /// menambahkan password ke akun Google yang sudah ada. Ini sengaja
  /// menghindari alur "hubungkan akun" yang jauh lebih rumit dan rawan
  /// salah untuk tim tanpa peninjau keamanan khusus.
  googleSub String? @unique @map("google_sub") @db.VarChar(191)

  /// `scrypt`: "salt:hash" heksadesimal — pola SAMA PERSIS dengan
  /// `users.password_hash` (lihat lib/auth/password.ts). NULL untuk akun
  /// yang cuma pernah masuk lewat Google.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// UNIK sejak password ditambahkan — jadi kunci pencarian akun saat masuk
  /// manual. Sebelumnya (Google-only) sengaja TIDAK unik karena identitas
  /// sebenarnya adalah `googleSub`; sekarang harus unik supaya satu email
  /// tidak bisa dipakai mendaftar dua kali dengan cara berbeda tanpa
  /// disadari menjadi dua akun terpisah.
  email String @unique @db.VarChar(191)
  name  String @db.VarChar(191)

  /// Nama masuk alternatif, dipakai bareng email saat login manual — lihat
  /// findCustomerByEmailOrUsername di lib/auth/customer-password.ts.
  ///
  /// NULLABLE: akun Google tidak pernah mengisi ini saat login pertama
  /// (Google tidak memberi username). Wajib diisi lewat /akun/lengkapi-profil
  /// sebelum akun itu bisa dipakai lebih lanjut — lihat requireCompleteProfile
  /// di lib/auth/customer.ts. Akun daftar-manual mengisinya sejak awal, jadi
  /// baris itu tidak pernah transit lewat NULL.
  username String? @unique @db.VarChar(32)

  /// Wajib untuk keperluan follow-up CS (checkout WhatsApp, konfirmasi
  /// pesanan). Sama seperti `username`: NULLABLE hanya karena akun Google
  /// tidak pernah mengisinya di langkah OAuth itu sendiri — wajib dilengkapi
  /// lewat /akun/lengkapi-profil, TIDAK boleh dilewati (skip). Tidak diberi
  /// `@unique`: satu nomor HP yang sama dipakai beberapa anggota keluarga
  /// untuk akun terpisah adalah kasus wajar, tidak seperti email/username.
  /// Format disimpan apa adanya (string), validasi angka+panjang di server
  /// action — tanpa verifikasi OTP (belum ada integrasi SMS/WA di project
  /// ini, lihat CLAUDE.md §2.1 kalau ini mau ditambah nanti).
  phoneNumber String? @map("phone_number") @db.VarChar(20)

  /// NULL = akun daftar-manual yang belum mengklik link verifikasi, dan
  /// BELUM BOLEH dipakai masuk. Akun dari Google selalu langsung terisi
  /// (Google sudah membuktikan kepemilikan email itu, tidak perlu verifikasi
  /// kedua) — lihat exchangeCodeForIdentity di lib/auth/google.ts yang
  /// menolak id_token dengan email_verified != true.
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Penanda pencabutan sesi, pola yang sama dengan `users.password_changed_at`
  /// — token yang terbit sebelum waktu ini dianggap mati walau tanda tangan
  /// dan masa berlakunya masih sah. Diisi (bukan dihapus barisnya) sesaat
  /// sebelum akun dihapus, supaya cookie yang sudah beredar tidak "masih
  /// login" ke akun yang sudah tidak ada. Juga diisi saat reset password
  /// berhasil, supaya sesi yang mungkin sudah dibajak lewat password lama
  /// langsung mati.
  sessionsRevokedAt DateTime? @map("sessions_revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  savedBuilds SavedPcBuild[]
  verificationTokens CustomerVerificationToken[]

  @@map("customers")
}

/**
 * Token sekali pakai untuk verifikasi email dan reset password — dua
 * kebutuhan yang bentuknya identik (kirim link ke email, klik, tervalidasi
 * sekali, kedaluwarsa), jadi satu tabel dengan `purpose`, bukan dua tabel
 * kembar.
 */
model CustomerVerificationToken {
  id String @id @default(uuid())

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// SHA-256 dari token mentah, BUKAN token itu sendiri — pola sama seperti
  /// cookie sesi (lib/auth/customer-session.ts): kalau tabel ini pernah
  /// bocor (dump database, log query), penyerang tidak bisa langsung
  /// memakai isinya untuk verifikasi/reset. Token mentah hanya pernah ada
  /// di URL yang dikirim ke email pemilik akun.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  /// "verify_email" | "reset_password". String biasa (bukan enum Prisma) —
  /// lihat docs/06-coding-standards.md §1.4, project ini menghindari enum
  /// Prisma untuk union kecil semacam ini.
  purpose String @db.VarChar(32)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerId, purpose])
  @@map("customer_verification_tokens")
}

/**
 * Rakitan PC yang disimpan pelanggan dari /build-pc. TIDAK berhubungan dengan
 * `PcBuildQuote`/`PcBuildSubmission` — dua sistem itu adalah snapshot harga
 * BEKU untuk dokumen penawaran cetak (harganya sengaja tidak pernah berubah
 * setelah dicetak, demi `/verify/[code]`).
 *
 * Rakitan tersimpan berbeda: harga yang DIBAYAR selalu harga katalog
 * TERKINI (dibaca ulang dari `Product` setiap kali ditampilkan — nama,
 * gambar, ketersediaan pun begitu; lihat CLAUDE.md §2.7), TAPI `items` juga
 * menyimpan harga acuan PER KOMPONEN pada saat disimpan/terakhir
 * "diperbarui", supaya pelanggan bisa melihat berapa yang naik/turun sejak
 * ia terakhir melihat rakitannya — pola yang sama seperti `/verify/[code]`
 * membandingkan `PcBuildQuote.items[].price` dengan harga sekarang. Harga
 * acuan ini murni pembanding tampilan, bukan angka yang pernah dipakai
 * sebagai dasar pembayaran/checkout.
 *
 * Layer pembaca (lib/api/saved-pc-builds.ts) yang menghitung selisihnya dan
 * menandai komponen yang sudah dihapus/di-draft-kan staff sebagai "tidak
 * tersedia" — bukan kolom di sini.
 */
model SavedPcBuild {
  id         String @id @default(uuid())
  customerId String @map("customer_id")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name String @db.VarChar(120)

  /// [{ stepId, stepName, productId, quantity, price }]. `price` = harga
  /// acuan per satuan saat disimpan/terakhir diperbarui — lihat catatan di
  /// atas model.
  items Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId, updatedAt])
  @@map("saved_pc_builds")
}

/**
 * Jejak penghapusan akun pelanggan.
 *
 * Penghapusan akun pelanggan bersifat permanen (CLAUDE.md §2.8: hard delete,
 * cascade ke rakitan tersimpan). Tanpa tabel ini, tindakan yang paling tidak
 * bisa dibatalkan di seluruh panel justru satu-satunya yang tidak meninggalkan
 * bekas apa pun — tidak ada cara menjawab "siapa yang menghapus akun ini, dan
 * atas dasar apa" beberapa bulan kemudian.
 *
 * YANG SENGAJA TIDAK DISIMPAN: email, nama, nomor HP, username. Justru itulah
 * data yang pelanggan minta dihapus. Menyalinnya ke tabel audit berarti
 * penghapusannya tidak pernah benar-benar terjadi — persis masalah yang dibahas
 * §2.8 soal kenapa akun pelanggan tidak boleh soft delete. Yang tersisa di sini
 * hanyalah UUID tak bermakna, angka, dan kalimat yang ditulis staff sendiri.
 *
 * TIDAK ADA foreign key ke `customers`. Bukan kelalaian: barisnya sudah tidak
 * ada saat log ini ditulis, jadi FK justru akan menolak penyimpanannya. Relasi
 * apa pun ke tabel itu juga berisiko menahan penghapusan yang seharusnya jalan.
 */
model CustomerDeletionLog {
  id String @id @default(uuid())

  /// UUID akun yang dihapus. Sengaja `String` biasa tanpa relasi — lihat
  /// catatan di atas. Berguna untuk mencocokkan kalau id-nya masih tercatat di
  /// tempat lain (mis. tiket CS), tapi dengan sendirinya tidak mengungkap
  /// siapa pun.
  deletedCustomerId String @map("deleted_customer_id") @db.VarChar(191)

  /// Admin yang menekan tombolnya. Diambil dari sesi server, TIDAK PERNAH dari
  /// formulir — jejak audit yang bisa dipalsukan oleh pelakunya sendiri tidak
  /// ada gunanya sebagai jejak (pola sama seperti `deletedBy` di `stores`).
  ///
  /// Tanpa FK juga: admin bisa dihapus (soft delete) belakangan, dan log ini
  /// harus tetap utuh meski begitu.
  deletedByUserId String @map("deleted_by_user_id") @db.VarChar(191)

  /// Berapa rakitan tersimpan yang ikut terhapus lewat cascade. Dihitung
  /// SEBELUM penghapusan, karena sesudahnya barisnya sudah tidak ada dan angka
  /// ini tidak bisa direkonstruksi dari mana pun.
  ///
  /// Bukan data pribadi — cuma angka — tapi menjawab pertanyaan yang wajar
  /// muncul belakangan: "pelanggan bilang kehilangan rakitannya, memang ada
  /// berapa?"
  savedBuildCount Int @map("saved_build_count")

  /// Alasan singkat yang diketik staff (mis. "permintaan hapus data via CS
  /// WhatsApp 12 Agt"). Wajib diisi — kolomnya NOT NULL dan server action
  /// menolak string kosong.
  ///
  /// Ini satu-satunya kolom yang bisa memuat teks bebas, jadi satu-satunya yang
  /// bisa kemasukan data pribadi kalau staff menuliskannya. Antarmukanya
  /// memberi peringatan; secara teknis tidak ada yang bisa mencegahnya, dan
  /// membatasinya lebih jauh akan membuat alasannya tidak berguna.
  reason String @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([deletedByUserId])
  @@map("customer_deletion_logs")
}
