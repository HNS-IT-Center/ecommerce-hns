# ============================================================================
# HNS IT Center — Next.js Environment Variables
# ============================================================================
# Salin file ini menjadi `.env.local` untuk development.
# JANGAN commit `.env.local` ke Git.
# Detail lengkap tiap variabel ada di docs/07-environment-variables.md
# ============================================================================


# ----------------------------------------------------------------------------
# [WAJIB] WooCommerce
# ----------------------------------------------------------------------------
# URL base WordPress (TANPA /wp-json di akhir)
WOOCOMMERCE_URL=https://hnsitcenter.id

# API key dari: wp-admin -> WooCommerce -> Settings -> Advanced -> REST API
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ----------------------------------------------------------------------------
# [WAJIB] Site
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=HNS IT Center

# Hostname image WordPress (dipakai next/image remotePatterns)
NEXT_PUBLIC_IMAGE_DOMAIN=hnsitcenter.id


# ----------------------------------------------------------------------------
# [WAJIB] Webhook Revalidation
# ----------------------------------------------------------------------------
# Generate: openssl rand -hex 32
# Nilai ini juga dimasukkan sebagai "Secret" di WooCommerce -> Webhooks
REVALIDATE_SECRET=change-me-with-random-32-chars-or-more


# ----------------------------------------------------------------------------
# [WAJIB] WhatsApp CS
# ----------------------------------------------------------------------------
# Format internasional TANPA tanda + atau 00 (contoh: 62821xxxxxxx)
NEXT_PUBLIC_WHATSAPP_CS_NUMBER=628xxxxxxxxxx


# ----------------------------------------------------------------------------
# [OPSIONAL] Payment Gateway — Midtrans
# Aktifkan setelah checkout online siap. Fase 1 bisa pakai WA order dulu.
# ----------------------------------------------------------------------------
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
# MIDTRANS_IS_PRODUCTION=false


# ----------------------------------------------------------------------------
# [OPSIONAL] Payment Gateway — Xendit (alternatif Midtrans)
# ----------------------------------------------------------------------------
# XENDIT_SECRET_KEY=xnd_development_xxxxx
# XENDIT_WEBHOOK_TOKEN=xxxxx


# ----------------------------------------------------------------------------
# [OPSIONAL] Search — Meilisearch (Fase 2)
# Aktifkan setelah katalog besar & butuh search cepat + faceted
# ----------------------------------------------------------------------------
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=masterKey
# NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
# NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=search-only-key-xxxxx


# ----------------------------------------------------------------------------
# [OPSIONAL] Analytics & Marketing
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FB_PIXEL_ID=xxxxxxxxxx


# ----------------------------------------------------------------------------
# [OPSIONAL] Error Tracking — Sentry
# ----------------------------------------------------------------------------
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx


# ----------------------------------------------------------------------------
# [OPSIONAL] Email SMTP
# Dibutuhkan untuk service booking notif, order confirmation, dll
# ----------------------------------------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxx
# SMTP_FROM=noreply@hnsitcenter.id


# ----------------------------------------------------------------------------
# [WAJIB untuk Admin Panel] Auth — kunci penanda tangan cookie sesi
# ----------------------------------------------------------------------------
# Tanpa ini login admin tidak bisa jalan. Minimal 32 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# JANGAN pakai nilai yang sama antara development dan produksi — mengganti nilai
# ini membatalkan seluruh sesi yang sedang berjalan, yang justru berguna kalau
# suatu saat perlu memaksa semua orang login ulang.
AUTH_SECRET=

# AUTH_URL tidak dipakai. Sesi admin memakai cookie bertanda tangan sendiri,
# bukan Auth.js, jadi tidak ada URL callback yang perlu dikonfigurasi.


# ----------------------------------------------------------------------------
# [OPSIONAL] Akun Pelanggan — Google OAuth
# Login pelanggan (/login) — simpan rakitan PC, riwayat pesanan. Setup
# lengkap: docs/09-google-oauth-setup.md. Tanpa ini /api/auth/google
# membalas error yang jelas, sisa aplikasi tetap jalan normal.
# ----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx


# ----------------------------------------------------------------------------
# [OPSIONAL] Admin Panel — WordPress Application Password
# Dipakai buat upload gambar produk lewat admin panel (WordPress Media REST
# API, /wp-json/wp/v2/media) — BEDA kredensial dari WOOCOMMERCE_CONSUMER_KEY/
# SECRET di atas (yang cuma valid untuk /wp-json/wc/v3/).
# Setup: wp-admin -> Users -> Profile -> Application Passwords -> generate.
# ----------------------------------------------------------------------------
# WORDPRESS_APP_USER=admin
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx


# ----------------------------------------------------------------------------
# [OPSIONAL] Admin Panel — Database (Prisma + MariaDB Hostinger)
# Dipakai buat data non-produk yang dikelola admin panel (toko/lokasi, konten
# kebijakan/FAQ). Belum wajib untuk storefront utama berjalan (ada fallback).
# Setup: buat database MariaDB di hPanel Hostinger, lalu:
#   npx prisma migrate dev --name init
#   npx prisma db seed
# ----------------------------------------------------------------------------
# DATABASE_URL="mysql://user:password@host:3306/dbname"


# ----------------------------------------------------------------------------
# [OPSIONAL] Admin Panel — Cloudflare R2 (penyimpanan gambar produk)
# Jalur upload alternatif dari WordPress Media di atas. Tanpa kelimanya, upload
# lewat R2 menolak dengan pesan jelas dan sisa aplikasi tetap jalan normal.
# Setup: Cloudflare dashboard -> R2 -> buat bucket -> Manage API Tokens.
# NEXT_PUBLIC_R2_PUBLIC_URL adalah domain publik bucket (custom domain atau
# r2.dev), dipakai untuk menyusun URL gambar yang tersimpan.
# ----------------------------------------------------------------------------
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET_NAME=hns-product-images
# NEXT_PUBLIC_R2_PUBLIC_URL=https://media.hnsitcenter.id


# ----------------------------------------------------------------------------
# [OPSIONAL] Admin Panel — AI untuk merapikan spesifikasi produk
# Dipakai /api/admin/format-specs: mengubah teks spesifikasi berantakan hasil
# copy-paste jadi tabel HTML. Tanpa ini tombolnya membalas error 500 yang rapi.
# ----------------------------------------------------------------------------
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx
